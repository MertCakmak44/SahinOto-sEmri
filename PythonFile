    def reset_form_data(self):
        bugun = datetime.date.today().strftime("%d.%m.%Y")
        self.is_emri_no = self.peek_next_order_no()
        self.data = {
            "musteri_adi": "",
            "telefon": "",
            "adres": "",
            "arac_model": "",
            "teslim_tarihi": bugun,
            "sasi_no": "",
            "km": "",
            "sikayet": "",
            "yapilan_islemler": "",
            "islem_turleri": {
                "Periyodik Bakım": False,
                "Arıza Onarım": False,
                "Kontrol": False,
                "Diğer": False
            },
            "parcalar": [],
            "iscilik": 0.0
        }
        self.current_step = 1
        self.part_substep = 0
        self.temp_part = {}
        self.last_part_msg = ""

    def peek_next_order_no(self):
        last_no = 0
        if os.path.exists(self.config_file):
            try:
                with open(self.config_file, "r", encoding="utf-8") as f:
                    cfg = json.load(f)
                    last_no = int(cfg.get("last_order_no", 0))
            except Exception:
                last_no = 0
        return f"{last_no + 1:04d}"

    def increment_and_save_order_no(self):
        current_int = int(self.is_emri_no)
        try:
            with open(self.config_file, "w", encoding="utf-8") as f:
                json.dump({"last_order_no": current_int}, f, ensure_ascii=False, indent=2)
        except Exception:
            pass

